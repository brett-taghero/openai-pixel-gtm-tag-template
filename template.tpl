___SANDBOXED_JS_FOR_WEB_TEMPLATE___

// ─── Sandboxed API imports ───────────────────────────────────────────────────
const injectScript = require('injectScript');
const createArgumentsQueue = require('createArgumentsQueue');
const copyFromDataLayer = require('copyFromDataLayer');
const copyFromWindow = require('copyFromWindow');
const setInWindow = require('setInWindow');
const callInWindow = require('callInWindow');
const makeInteger = require('makeInteger');
const makeString = require('makeString');
const getType = require('getType');
const log = require('logToConsole');

// ─── Template data ────────────────────────────────────────────────────────────
const pixelId      = data.pixelId;
const debugMode    = data.debugMode;
const eventType    = data.eventType;

const PIXEL_URL = 'https://bzrcdn.openai.com/sdk/oaiq.min.js';

// ─── Helpers ──────────────────────────────────────────────────────────────────

/**
 * Safely parse a value to an integer, returning undefined if invalid.
 */
function toInt(v) {
  if (v === '' || v === null || v === undefined) return undefined;
  var n = makeInteger(v);
  return n ? n : undefined;
}

/**
 * Build contents[] array from MAP rows.
 * GTM MAP type produces [{key: "id", value: "sku_1"}, {key: "name", value: "..."}, ...]
 * Multiple items are detected when the 'id' (or any field) key repeats —
 * each repetition of 'id' starts a new item. If no 'id' rows exist, all
 * fields are treated as a single item.
 */
function buildContentsFromMapRows(rows) {
  var allItems = [];
  if (!rows || rows.length === 0) return allItems;

  var current = {};
  var hasFields = false;
  var seenId = false;

  for (var i = 0; i < rows.length; i++) {
    var k = rows[i].key;
    var v = rows[i].value;
    if (!k || v === undefined || v === '') continue;

    // When we see 'id' again and we already have one, flush the current item
    if (k === 'id' && seenId) {
      if (hasFields) allItems.push(buildContentItemFromMap(current));
      current = {};
      hasFields = false;
      seenId = false;
    }

    current[k] = v;
    hasFields = true;
    if (k === 'id') seenId = true;
  }
  if (hasFields) allItems.push(buildContentItemFromMap(current));
  return allItems;
}

/**
 * Build a single contents[] item from a flat map of field→value.
 */
function buildContentItemFromMap(map) {
  var item = {};
  if (map.id)           item.id           = makeString(map.id);
  if (map.name)         item.name         = makeString(map.name);
  if (map.content_type) item.content_type = makeString(map.content_type);
  var qty = toInt(map.quantity);
  if (qty !== undefined) item.quantity = qty;
  var amt = toInt(map.amount);
  if (amt !== undefined) item.amount = amt;
  if (map.currency)     item.currency = makeString(map.currency);
  return item;
}

// ─── GA4 / Enhanced Ecommerce dataLayer mapping ───────────────────────────────

var GA4_EVENT_MAP = {
  'page_view':        'page_viewed',
  'view_item':        'contents_viewed',
  'view_item_list':   'contents_viewed',
  'add_to_cart':      'items_added',
  'begin_checkout':   'checkout_started',
  'purchase':         'order_created',
  'generate_lead':    'lead_created',
  'sign_up':          'registration_completed'
};

function buildFromGA4() {
  // Read the GA4 event name directly from the dataLayer — no dropdown needed.
  // The tag is configured to fire on GA4 ecommerce triggers so the event name
  // is always present as the 'event' key on the most recent dataLayer push.
  var ga4Event    = copyFromDataLayer('event') || '';
  var oaiEvent    = GA4_EVENT_MAP[ga4Event] || ga4Event;

  // Read from the dataLayer ecommerce object
  var ecommerce   = copyFromDataLayer('ecommerce') || {};
  var items       = ecommerce.items || [];
  var dlValue     = ecommerce.value;
  var dlCurrency  = ecommerce.currency;
  var dlTxId      = ecommerce.transaction_id;

  // Determine the OpenAI data shape
  var needsContents = (oaiEvent === 'page_viewed'    ||
                       oaiEvent === 'contents_viewed' ||
                       oaiEvent === 'items_added'     ||
                       oaiEvent === 'checkout_started'||
                       oaiEvent === 'order_created');

  var needsCustomerAction = (oaiEvent === 'lead_created' ||
                              oaiEvent === 'registration_completed' ||
                              oaiEvent === 'appointment_scheduled');

  var eventProps = {};

  if (needsContents) {
    eventProps.type = 'contents';
    // Map GA4 items to OpenAI contents[]
    var contents = [];
    for (var i = 0; i < items.length; i++) {
      var it = items[i];
      contents.push({
        id:           it.item_id   || it.id   || '',
        name:         it.item_name || it.name || '',
        content_type: it.item_category || 'product',
        quantity:     toInt(it.quantity) || 1,
        amount:       it.price ? makeInteger(it.price * 100) : undefined,
        currency:     it.currency || dlCurrency || ''
      });
    }
    if (contents.length > 0) eventProps.contents = contents;

  } else if (needsCustomerAction) {
    eventProps.type = 'customer_action';
  } else {
    eventProps.type = 'contents'; // fallback
  }

  // Map value → amount (GA4 uses decimal, OpenAI uses lowest denomination integer)
  if (dlValue !== undefined && dlValue !== null && dlValue !== '') {
    eventProps.amount = makeInteger(dlValue * 100);
  }
  if (dlCurrency) eventProps.currency = makeString(dlCurrency);

  // Build eventOptions
  var eventOptions = {};
  if (dlTxId) eventOptions.event_id = makeString(dlTxId);

  return {
    oaiEventName: oaiEvent,
    eventProps: eventProps,
    eventOptions: eventOptions
  };
}

// ─── Standard / Custom event builders ────────────────────────────────────────

function buildStandardEvent() {
  var eventName = data.standardEventName;

  // Determine data shape by event name
  var useContents = (eventName === 'page_viewed'     ||
                     eventName === 'contents_viewed'  ||
                     eventName === 'items_added'      ||
                     eventName === 'checkout_started' ||
                     eventName === 'order_created');

  var usePlanEnrollment = (eventName === 'subscription_created' ||
                            eventName === 'trial_started');

  var useCustomerAction = (eventName === 'lead_created'            ||
                            eventName === 'registration_completed'  ||
                            eventName === 'appointment_scheduled');

  var eventProps = {};

  if (useContents) {
    eventProps.type = 'contents';
    var contents = buildContentsFromMapRows(data.contentsItems);
    if (contents.length > 0) eventProps.contents = contents;
  } else if (usePlanEnrollment) {
    eventProps.type = 'plan_enrollment';
    if (data.planId) eventProps.plan_id = makeString(data.planId);
    var planContents = buildContentsFromMapRows(data.contentsItems);
    if (planContents.length > 0) eventProps.contents = planContents;
  } else if (useCustomerAction) {
    eventProps.type = 'customer_action';
  }

  var amt = toInt(data.eventAmount);
  if (amt !== undefined) {
    eventProps.amount = amt;
    if (data.eventCurrency) eventProps.currency = makeString(data.eventCurrency);
  }

  var eventOptions = {};
  if (data.eventId) eventOptions.event_id = makeString(data.eventId);

  return {
    oaiEventName: eventName,
    eventProps: eventProps,
    eventOptions: eventOptions
  };
}

function buildCustomEvent() {
  var eventProps = { type: 'custom' };

  if (data.planId) eventProps.plan_id = makeString(data.planId);

  var amt = toInt(data.eventAmount);
  if (amt !== undefined) {
    eventProps.amount = amt;
    if (data.eventCurrency) eventProps.currency = makeString(data.eventCurrency);
  }

  var contents = buildContentsFromMapRows(data.contentsItems);
  if (contents.length > 0) eventProps.contents = contents;

  var eventOptions = { custom_event_name: makeString(data.customEventName) };
  if (data.eventId) eventOptions.event_id = makeString(data.eventId);

  return {
    oaiEventName: 'custom',
    eventProps: eventProps,
    eventOptions: eventOptions
  };
}

function buildGtmVariableEvent() {
  // The event name comes from a GTM variable resolved at runtime
  var eventName = makeString(data.gtmVariableEventName);

  // Re-use the standard event builder logic keyed on the resolved name
  var useContents = (eventName === 'page_viewed'     ||
                     eventName === 'contents_viewed'  ||
                     eventName === 'items_added'      ||
                     eventName === 'checkout_started' ||
                     eventName === 'order_created');

  var usePlanEnrollment = (eventName === 'subscription_created' ||
                            eventName === 'trial_started');

  var useCustomerAction = (eventName === 'lead_created'            ||
                            eventName === 'registration_completed'  ||
                            eventName === 'appointment_scheduled');

  var isCustom = (eventName === 'custom');

  var eventProps = {};

  if (isCustom) {
    eventProps.type = 'custom';
    if (data.planId) eventProps.plan_id = makeString(data.planId);
  } else if (useContents) {
    eventProps.type = 'contents';
    var contents = buildContentsFromMapRows(data.contentsItems);
    if (contents.length > 0) eventProps.contents = contents;
  } else if (usePlanEnrollment) {
    eventProps.type = 'plan_enrollment';
    if (data.planId) eventProps.plan_id = makeString(data.planId);
  } else if (useCustomerAction) {
    eventProps.type = 'customer_action';
  } else {
    // Unknown / unmapped event name — default to contents shape
    eventProps.type = 'contents';
  }

  var amt = toInt(data.eventAmount);
  if (amt !== undefined) {
    eventProps.amount = amt;
    if (data.eventCurrency) eventProps.currency = makeString(data.eventCurrency);
  }

  var eventOptions = {};
  if (data.eventId) eventOptions.event_id = makeString(data.eventId);
  if (isCustom && data.customEventName) {
    eventOptions.custom_event_name = makeString(data.customEventName);
  }

  return {
    oaiEventName: isCustom ? 'custom' : eventName,
    eventProps: eventProps,
    eventOptions: eventOptions
  };
}

// ─── Determine event payload based on event type ──────────────────────────────

var payload;
if (eventType === 'ga4_ecommerce') {
  payload = buildFromGA4();
} else if (eventType === 'custom') {
  payload = buildCustomEvent();
} else if (eventType === 'gtm_variable') {
  payload = buildGtmVariableEvent();
} else {
  payload = buildStandardEvent();
}

if (debugMode) {
  log('[OpenAI Ads Pixel] Event:', payload.oaiEventName);
  log('[OpenAI Ads Pixel] Props:', payload.eventProps);
  log('[OpenAI Ads Pixel] Options:', payload.eventOptions);
}

// ─── Pixel bootstrap & fire ───────────────────────────────────────────────────

var oaiq = createArgumentsQueue('oaiq', 'oaiq.q');

// Initialize if not already done (idempotent — pixel checks window.oaiq itself)
var initConfig = { pixelId: pixelId };
if (debugMode) initConfig.debug = true;

oaiq('init', initConfig);

// Fire the measurement call
oaiq('measure', payload.oaiEventName, payload.eventProps, payload.eventOptions);

// Inject the pixel SDK script (once per page)
injectScript(PIXEL_URL, data.gtmOnSuccess, data.gtmOnFailure, 'openai_pixel_sdk');


